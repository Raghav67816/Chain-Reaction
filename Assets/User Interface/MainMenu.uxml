<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/User%20Interface/TerminalTheme.uss?fileID=7433441132597879392&amp;guid=8e48f41dbbc82f2468e44afa9386e605&amp;type=3#TerminalTheme"/>
    <ui:VisualElement name="Screen" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(0, 0, 0); flex-direction: column; flex-wrap: nowrap; position: relative;">
        <ui:VisualElement name="TerminalWindow" class="terminal-window">
            <ui:VisualElement name="Header" style="flex-grow: 1; flex-direction: row; justify-content: space-between; height: 10%; position: absolute; width: 100%; border-left-color: rgb(84, 255, 0); border-right-color: rgb(84, 255, 0); border-top-color: rgb(84, 255, 0); border-bottom-color: rgb(84, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 3px; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;">
                <ui:Label text="DATA CENTER 15X07" name="WindowTitle" style="font-size: 24px; -unity-text-align: middle-left; color: rgb(79, 255, 0); left: 5px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&amp;guid=6140df17fdfb84345b513d585adf193c&amp;type=3#VT323-Regular&quot;);"/>
                <ui:Label text="X" name="Close" style="font-size: 24px; -unity-text-align: middle-left; color: rgb(86, 255, 0); right: 5px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&amp;guid=6140df17fdfb84345b513d585adf193c&amp;type=3#VT323-Regular&quot;);"/>
            </ui:VisualElement>
            <ui:Label text="CHAIN RXN" name="Title" style="top: 20%; font-size: 128px; -unity-text-align: middle-center; color: rgb(79, 255, 0); -unity-font-definition: url(&quot;project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&amp;guid=6140df17fdfb84345b513d585adf193c&amp;type=3#VT323-Regular&quot;);"/>
            <ui:Image source="project://database/Assets/Sprites/Server/l0_sprite_server2.png?fileID=1658087982670268620&amp;guid=accef3e25ad94184385e50259384a4cd&amp;type=3#l0_sprite_server2_0" scale-mode="ScaleToFit" name="Servers" style="top: 20%; width: 50%; align-self: center;"/>
            <ui:VisualElement name="ButtonBox" class="button-box" style="flex-grow: 0; top: 20%; flex-direction: row; align-items: center; justify-content: center; align-self: center; position: relative; align-content: center; flex-wrap: nowrap; width: 100%;">
                <ui:Button text="Start Shift" name="StartButton" class="button normal-button"/>
                <ui:Button text="Settings" name="SettingsButton" class="normal-button"/>
                <ui:Button text="Exit Shift" name="ExitShiftButton" class="danger-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="Signal" style="flex-grow: 0; top: 20%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
