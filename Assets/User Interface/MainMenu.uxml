<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/User%20Interface/TerminalTheme.uss?fileID=7433441132597879392&amp;guid=8e48f41dbbc82f2468e44afa9386e605&amp;type=3#TerminalTheme"/>
    <ui:VisualElement name="Screen" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(0, 0, 0); flex-direction: column; flex-wrap: nowrap; position: relative;">
        <ui:VisualElement name="TerminalWindow" style="flex-grow: 1; left: auto; top: auto; right: auto; bottom: auto; position: absolute; align-self: auto; align-content: auto; width: 80%; height: 80%; -unity-font-definition: url(&quot;project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&amp;guid=6140df17fdfb84345b513d585adf193c&amp;type=3#VT323-Regular&quot;); border-left-color: rgb(84, 255, 0); border-right-color: rgb(84, 255, 0); border-top-color: rgb(84, 255, 0); border-bottom-color: rgb(84, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
            <ui:VisualElement name="Header" style="flex-grow: 1; flex-direction: row; justify-content: space-between; height: 10%; position: absolute; width: 100%; border-left-color: rgb(84, 255, 0); border-right-color: rgb(84, 255, 0); border-top-color: rgb(84, 255, 0); border-bottom-color: rgb(84, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 3px; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;">
                <ui:Label text="DATA CENTER 15X07" name="WindowTitle" style="font-size: 24px; -unity-text-align: middle-left; color: rgb(79, 255, 0); left: 5px;"/>
                <ui:Label text="X" name="Close" style="font-size: 24px; -unity-text-align: middle-left; color: rgb(86, 255, 0); right: 5px;"/>
            </ui:VisualElement>
            <ui:Label text="CHAIN RXN" name="Title" style="top: 20%; font-size: 128px; -unity-text-align: middle-center; color: rgb(79, 255, 0);"/>
            <ui:Button text="PLAY" name="button" class="button" style="top: 30%; font-size: 28px; background-color: rgba(188, 188, 188, 0); color: rgb(79, 255, 0); position: relative; width: 20%; align-items: center; align-self: center;"/>
            <ui:Button text="SETTINGS" name="button" style="top: 30%; font-size: 28px; background-color: rgba(188, 188, 188, 0); color: rgb(79, 255, 0); width: 20%; align-self: center;"/>
            <ui:Button text="QUIT" name="button" style="top: 30%; font-size: 28px; color: rgb(255, 0, 0); background-color: rgba(188, 188, 188, 0); width: 20%; left: 0%; right: 0; align-self: center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
