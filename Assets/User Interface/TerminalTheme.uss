.normal-button {
    font-size: 28px;
    -unity-text-align: middle-center;
    align-self: center;
    color: rgb(79, 255, 0);
    width: 20%;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    align-content: center;
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&guid=6140df17fdfb84345b513d585adf193c&type=3#VT323-Regular");
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.danger-button {
    font-size: 28px;
    -unity-text-align: middle-center;
    align-self: center;
    color: rgb(255, 0, 0);
    width: 20%;
    background-color: transparent;
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Fonts/VT323/VT323-Regular.ttf?fileID=12800000&guid=6140df17fdfb84345b513d585adf193c&type=3#VT323-Regular");
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.terminal-window {
    width: 90%;
    height: 90%;
    outline: rgb(79, 255, 0);
    border-left-color: rgb(79, 255, 0);
    border-right-color: rgb(79, 255, 0);
    border-top-color: rgb(79, 255, 0);
    border-bottom-color: rgb(79, 255, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
}
